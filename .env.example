# 로컬 실행용 환경변수. 이 파일을 .env로 복사해 채운다.
# application.yml이 optional:file:.env로 읽어들이고, 운영에서는 실제 환경변수가 이 값을 덮는다.

# --- DB (필수) ---
# 호스트·포트·DB명은 기본값이 있어서 로컬 MySQL을 쓰면 비워도 된다
DB_USERNAME=
DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=moimzang

# --- AI ---
# gemini | openai — 채팅에 쓸 벤더를 고른다
AI_PROVIDER=openai
OPENAI_API_KEY=
# 영수증 인식(OCR)은 현재 구현이 Gemini만 있어서 이 키가 따로 필요하다.
# OpenAI로 전환하는 작업이 진행 중이고(#139), 그게 끝나면 이 키는 지운다.
# 영수증 기능을 쓰지 않으면 비워둬도 기동에는 문제가 없다
GEMINI_API_KEY=

# --- 파일 저장소 ---
# local | s3 — 기본은 local이고 ./uploads에 쌓인다. 운영은 s3
# STORAGE_TYPE=local
# AWS_S3_BUCKET=
# AWS_REGION=ap-northeast-2

# --- CORS ---
# 비우면 로컬 개발 주소(localhost:3000, localhost:5173)만 허용한다
# CORS_ALLOWED_ORIGINS=

# --- 기타 ---
# SERVER_PORT=8080
# SWAGGER_ENABLED=true
