# 로컬 실행용 환경변수. 이 파일을 .env로 복사해 채운다.
# application.yml이 optional:file:.env로 읽어들이고, 운영에서는 실제 환경변수가 이 값을 덮는다.

# --- DB (필수) ---
# 호스트·포트·DB명은 기본값이 있어서 로컬 MySQL을 쓰면 비워도 된다
DB_USERNAME=
DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=moimzang

# --- AI ---
# gemini | openai — 채팅에 쓸 벤더를 고른다
AI_PROVIDER=openai
# 채팅과 영수증 인식 둘 다 이 키를 쓴다
OPENAI_API_KEY=
# AI_PROVIDER=gemini 로 둘 때만 필요하다. openai로 쓰면 비워둬도 된다
GEMINI_API_KEY=

# --- 파일 저장소 ---
# local | s3 — 기본은 local이고 ./uploads에 쌓인다. 운영은 s3
# STORAGE_TYPE=local
# AWS_S3_BUCKET=
# AWS_REGION=ap-northeast-2

# --- CORS ---
# 비우면 로컬 개발 주소(localhost:3000, localhost:5173)만 허용한다
# CORS_ALLOWED_ORIGINS=

# --- 기타 ---
# SERVER_PORT=8080
# SWAGGER_ENABLED=true
